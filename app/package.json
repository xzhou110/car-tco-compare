{
  "name": "car-tco-compare-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Production web app for comparing total cost of ownership across 2–6 cars.",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "xzhou110",
  "scripts": {
    "dev": "vite --port 5191 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4191 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
