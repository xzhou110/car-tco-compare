# dependencies (production app, added later)
node_modules/
dist/
.vite/

# env / local
.env
.env.local
*.local

# editor / OS / local tooling
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# local backups written by the listings scripts (listings.json itself was removed on
# 2026-11-12, DECISIONS.md ADR-003) — keep them on disk but never commit them. Vite copies
# all of public/ into dist/, so a local build carries them; the deploy builds from a clean
# checkout and never sees them.
app/public/data/*.bak.json
